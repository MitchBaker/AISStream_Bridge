<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="aisstream.io API key" />

        <EditText
            android:id="@+id/apiKey"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Enter key to replace (password, not shown again)"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/keyStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="API key: not set" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Box size (nautical miles from center)" />

        <EditText
            android:id="@+id/spanNm"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Position source" />

        <RadioGroup
            android:id="@+id/sourceMode"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/srcGps"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="true" android:text="Use GPS (default)" />

            <RadioButton
                android:id="@+id/sourceManual"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Specify lat/lon" />
        </RadioGroup>

        <EditText
            android:id="@+id/manualLat"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Latitude (e.g. 41.29)"
            android:inputType="numberDecimal|numberSigned"
            android:visibility="gone" />

        <EditText
            android:id="@+id/manualLon"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Longitude (e.g. -72.37)"
            android:inputType="numberDecimal|numberSigned"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Message types to request (sent in subscription)" />

        <CheckBox
            android:id="@+id/chkPosA"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:checked="true" android:text="PositionReport (Class A)" />

        <CheckBox
            android:id="@+id/chkPosB"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:checked="true" android:text="StandardClassBPositionReport" />

        <CheckBox
            android:id="@+id/chkPosBE"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:checked="true"
            android:text="ExtendedClassBPositionReport (type 19 — Class B pos + name/type/dims)" />

        <CheckBox
            android:id="@+id/chkLongRange"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:checked="true" android:text="LongRangeAisBroadcastMessage (type 27)" />

        <CheckBox
            android:id="@+id/chkStaticData"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:checked="true"
            android:text="ShipStaticData (Class A static — type 5)" />

        <CheckBox
            android:id="@+id/chkStaticDataRpt"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:checked="true"
            android:text="StaticDataReport (Class B static — type 24)" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="Vessel filters (applied before conversion)" />

        <Switch
            android:id="@+id/swSkipAnchored"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Skip vessels At Anchor (status 1)" />

        <Switch
            android:id="@+id/swSkipMoored"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Skip vessels Moored (status 5)" />

        <Switch
            android:id="@+id/swSkipZeroSog"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Skip zero-SOG vessels when nav status absent" />

        <Switch
            android:id="@+id/swRewriteStale"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Rewrite contradicting nav status to 15 (Not available)" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Save settings" />
        <Button
            android:id="@+id/btnExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Export Vessel Data" />
        <Button
            android:id="@+id/btnImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Import Vessel Data" />
        <Button
            android:id="@+id/btnClearStore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Delete Vessel Store" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Debug capture"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/captureMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Capture minutes (default 10)"
            android:inputType="number"/>

        <Button
            android:id="@+id/btnCapture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start debug capture"/>

        <Button
            android:id="@+id/btnShareDebug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share latest debug capture"/>
        <TextView
            android:id="@+id/buildStamp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textSize="12sp"
            android:text="" />
    </LinearLayout>
</ScrollView>